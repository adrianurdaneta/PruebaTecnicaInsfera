{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=netflix;User=YOUR_USER;Password=YOUR_PASSWORD;"
  },
  "JwtSettings": {
    "Secret": "YOUR_SECRET_KEY_HERE_MINIMUM_32_CHARACTERS",
    "Issuer": "WatchlistAPI",
    "Audience": "WatchlistFront",
    "ExpirationInMinutes": 120
  }
}
